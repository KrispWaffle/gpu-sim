; Divergent if/else: tests SIMT divergence.
; Even-id threads take one path, odd-id threads take another.
; Both branches do real work, so the warp must serialize them.
;
; Expected register state at halt:
;   even threads (0,2,4,6,8): r0 = tidx * 2   ->  0, 4, 8, 12, 16
;   odd  threads (1,3,5,7,9): r0 = tidx + 100 -> 101, 103, 105, 107, 109
;
; In the Thread tab during the run you should see TWO PCs at once
; (the two splinters) until both branches reach `end:` and merge.

    and    r2, tidx, 1.0      ; r2 = tidx & 1   (0=even, 1=odd)
    cmp_lt r2, 0.5            ; predicate = is_even
    jmp    even               ; even threads jump; odd threads fall through

    ; --- odd path: r0 = tidx + 100 ---
    mov    r0, tidx
    add    r0, r0, 100.0
    cmp_lt 0.0, 1.0           ; trick: 0<1 is always true => unconditional jmp
    jmp    end

even:
    mov    r0, tidx
    mul    r0, r0, 2.0

end:
    halt
