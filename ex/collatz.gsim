; Collatz sequence starting from n=12
; if n is even: n = n / 2
; if n is odd:  n = 3n + 1
; repeat until n = 1, count steps
;
; Even/odd check: (n AND 1) == 0 means even
; Unconditional jump trick: cmp_lt 0.0, 1.0 always sets predicate=1
;
; Expected: 12->6->3->10->5->16->8->4->2->1  (9 steps)
; All 10 threads run in parallel, each with their own n/steps slots

def local  n      = 12 @ r0   ; n in register 0 (per-thread, no slot collision)
def local  steps  = 0  @ r1   ; step counter in register 1
def global out    = 0  tidx   ; final output, one slot per thread in global mem

collatz:
    and    r2, n, 1.0         ; r2 = n & 1  (0 if even, 1 if odd)
    cmp_lt r2, 0.5            ; predicate = (r2 < 0.5) = is even
    jmp    even               ; jump if even, fall through if odd (r2 == 1)

    ; odd path: n = 3n + 1
    mul    n, n, 3.0
    add    n, n, 1.0
    cmp_lt 0.0, 1.0           ; always true -> unconditional jump
    jmp    step

even:
    div    n, n, 2.0          ; even path: n = n / 2
                              ; falls through to step

step:
    add    steps, steps, 1.0
    cmp_lt 1.0, n             ; continue if n > 1
    jmp    collatz

st     out, steps             ; store final step count to global mem
halt
